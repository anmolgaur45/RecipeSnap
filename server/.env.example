# Server
PORT=3001
NODE_ENV=development

# Database (Supabase Postgres)
# DATABASE_URL: session pooler connection string used by Drizzle migrations.
# Format: postgresql://postgres.<ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ANON_KEY=          # public client key (mobile app)
SUPABASE_PUBLISHABLE_KEY=   # newer public client key
SUPABASE_SERVICE_ROLE_KEY=  # server-side admin key, never ship to the client

# Legacy SQLite (transitional, removed after the Postgres migration lands)
DB_PATH=./data/recipesnap.db

# AI APIs
ANTHROPIC_API_KEY=sk-ant-...   # required: OCR (Claude vision) + recipe structuring + substitution
OPENAI_API_KEY=sk-...          # optional: Whisper audio transcription (falls back to captions)

# Nutrition database
USDA_API_KEY=DEMO_KEY          # optional: USDA FoodData Central (free key at api.data.gov, DEMO_KEY is 30 req/hr)

# Video downloading
YTDLP_PATH=yt-dlp              # path to yt-dlp binary (defaults to 'yt-dlp' on PATH)
TEMP_DIR=/tmp/recipesnap       # temp dir for downloads (defaults to OS temp)

# Concurrency and limits
MAX_CONCURRENT_JOBS=2          # max simultaneous extraction jobs
RATE_LIMIT_RPM=               # optional: per-user request-per-minute cap

# CORS
CORS_ORIGIN=*                  # restrict to your app origin in production
