# Server
PORT=3001
NODE_ENV=development

# Database (Supabase Postgres)
# DATABASE_URL: session pooler connection string used by Drizzle migrations.
# Format: postgresql://postgres.<ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ANON_KEY=          # public client key (mobile app)
SUPABASE_PUBLISHABLE_KEY=   # newer public client key
SUPABASE_SERVICE_ROLE_KEY=  # server-side admin key, never ship to the client

# AI APIs
ANTHROPIC_API_KEY=sk-ant-...   # required: OCR (Claude vision) + structurer fallback + substitution
OPENAI_API_KEY=sk-...          # optional: Whisper audio transcription (falls back to captions)

# Vertex AI (primary structurer + recipe adaptation). Auth via ADC:
# Cloud Run uses the runtime service account; locally run
# `gcloud auth application-default login`.
GCP_PROJECT=                          # GCP project id (required for Vertex)
VERTEX_LOCATION=global                 # Vertex endpoint location; `global` dodges per-region model gaps
GEMINI_STRUCTURER_MODEL=gemini-3.5-flash            # primary structurer (GA on Vertex)
CLAUDE_STRUCTURER_MODEL=claude-haiku-4-5-20251001   # fallback structurer (Anthropic-direct)

# Nutrition database
USDA_API_KEY=DEMO_KEY          # optional: USDA FoodData Central (free key at api.data.gov, DEMO_KEY is 30 req/hr)

# Media tooling
YTDLP_PATH=yt-dlp              # path to yt-dlp binary (defaults to 'yt-dlp' on PATH)
FFMPEG_PATH=                   # optional: system ffmpeg path; defaults to the @ffmpeg-installer binary
TEMP_DIR=/tmp/recipesnap       # temp dir for downloads (defaults to OS temp)
THUMBNAILS_DIR=./data/thumbnails  # dev fallback dir for keyframe thumbnails

# Thumbnail storage (prod). When set, keyframes upload to a public Supabase
# Storage bucket; otherwise they fall back to THUMBNAILS_DIR served at /thumbnails.
SUPABASE_STORAGE_BUCKET=thumbnails

# Extraction queue (prod). When all three are set, /api/extract enqueues a
# Cloud Task to the worker instead of running the pipeline inline.
CLOUD_TASKS_QUEUE=             # Cloud Tasks queue id
WORKER_URL=                    # base URL of the deployed worker service
WORKER_INVOKER_SA=            # service account email Cloud Tasks uses (also verified by the worker)
GCP_PROJECT=                   # GCP project id (Cloud Tasks)
GCP_LOCATION=us-central1       # Cloud Tasks / Cloud Run region

# Concurrency and limits
MAX_CONCURRENT_JOBS=2          # max simultaneous extraction jobs per instance
RATE_LIMIT_RPM=               # optional: per-user request-per-minute cap

# CORS
CORS_ORIGIN=*                  # restrict to your app origin in production
