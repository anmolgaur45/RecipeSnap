# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3001

# Supabase (public client keys, safe to ship in the app bundle)
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side keys (service role, DB password, AI keys) live in server/.env only
# and must NEVER be in the mobile app bundle.
